# PaperOrchestra environment file.
# Copy this to a file named ".env" in the repo root and fill in YOUR OWN keys.
# These keys authorize paid model calls — keep this file private, never commit it.

# --- Literature review (required for the Literature agent) ---
# Free key from https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# --- Gemini models (DEFAULT provider; models default to gemini-3.1-pro-preview) ---
# Pick ONE of the two options below:
#   Option A: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Option B: Vertex AI (instead of the key above) — needs a Google Cloud project
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# --- OpenAI (optional; only if you pass OpenAI model names via --writer_model_name etc.) ---
OPENAI_API_KEY=

# --- SMTP (optional; only for the Streamlit demo's "email me the result" option) ---
SMTP_EMAIL=
SMTP_PASSWORD=
